# Copy this file to .env and adjust as needed.
# ./install.sh creates .env from this file automatically on first run.

# Where region tiles, the POI db and the region registry are stored.
# Point this at your SSD mount on a Raspberry Pi, e.g. /mnt/ssd/maps/data —
# re-run ./install.sh after changing this to move existing data there.
DATA_DIR=./data

# Where vendored fonts/sprites are stored.
# Can also point at an SSD mount, e.g. /mnt/ssd/maps/assets, if you want
# everything off the SD card.
ASSETS_DIR=./assets

# Host port offline-maps listens on (mapped 1:1 to the container's internal
# port 8080, which is fixed by the Dockerfile and not configurable here).
# NB: other offline-pi apps use 8081 (knowledge), so keep this out of the way
# if you change it.
PORT=8080

# Extra origins allowed to call /api, comma-separated, e.g.
# http://maps.local:8080,http://192.168.1.50:8080
# The server this port and localhost/127.0.0.1 are always allowed; add more
# here for unusual setups (custom hostname, reverse proxy, etc.)
ALLOWED_ORIGINS=

# Unset -> points of interest are stored in $DATA_DIR/offline-maps.db (sqlite).
# Set to a postgres:// url to use Postgres instead, e.g.
# postgres://maps:secret@db:5432/maps
DATABASE_URL=

# Set to true to log every SQL statement (debugging only).
DB_LOGGING=false
