# ---------------------------------------------------------------- deps ---
node_modules/
.npm/
*.tsbuildinfo
.eslintcache

# --------------------------------------------------------------- build ---
dist/
build/
coverage/

# --------------------------------------------- generated map data & tools ---
# go-pmtiles CLI — `npm run maps:setup` (repo root)
/bin/*
!/bin/.gitkeep

# region archives are hundreds of MB — `npm run region:add`
/data/regions/
# local registry of what this machine has downloaded
/data/regions.json
# sqlite database holding points of interest (-wal / -shm are WAL sidecars)
/data/offline-maps.db
/data/offline-maps.db-*
# 554-entry Geofabrik catalog — `npm run maps:setup` (repo root)
/data/geofabrik-index.json

# vendored fonts & sprites — `npm run assets:fetch`
/assets/fonts/
/assets/sprites/

# download staging
/.tmp/

