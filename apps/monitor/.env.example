# Copy this file to .env and adjust as needed.
# ./install.sh creates .env from this file automatically on first run.

# Where the 24 h metric history and the power event log are stored
# (history.json, well under 1 MB). Can point at your SSD mount on a
# Raspberry Pi, e.g. /mnt/ssd/monitor/data; re-run ./install.sh after
# changing this to move existing data there.
DATA_DIR=./data

# Port the dashboard listens on. The container uses host networking, so this
# is the port on the Pi itself.
# NB: other offline-pi apps use 8081 (maps) and 8082 (knowledge).
PORT=8080

# Address to listen on: 0.0.0.0 for LAN access, 127.0.0.1 for local only.
BIND_ADDRESS=0.0.0.0

# How often the Pi is sampled and pushed to open dashboards, in milliseconds.
SAMPLE_INTERVAL_MS=2000

# Host path of Podman's storage (its db.sql lists the containers shown on
# the dashboard). install.sh fills this in from `podman info` on every run;
# leave empty to search the default rootless/rootful locations.
PODMAN_GRAPH_ROOT=

# Let the dashboard start and stop the other apps' containers (true/false).
# Uses the Podman REST API via the user's podman.socket, which install.sh
# enables when you say yes. Anyone who can open the dashboard can then stop
# apps, so keep it false (or BIND_ADDRESS=127.0.0.1) on an untrusted network.
CONTAINER_CONTROL=false

# Host path of the Podman API socket used when CONTAINER_CONTROL=true.
# install.sh fills this in from `podman info` on every run.
PODMAN_SOCKET=

# Firmware mailbox device used for voltages and throttle flags (vcgencmd).
# install.sh detects it on every run: /dev/vcio_gencmd (current Raspberry Pi
# kernels, group video), /dev/vcio on older ones, /dev/null if not a Pi.
VCIO_DEVICE=/dev/vcio_gencmd
