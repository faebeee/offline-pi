# Configuration for hotspot-fallback
# Copy this file to /etc/hotspot-fallback.env and fill in real values.
# That file is sourced by /usr/local/bin/hotspot-fallback.sh at boot.

# WiFi interface to use (check with: nmcli device status)
WIFI_IFACE=wlan0

# The WLAN you prefer to connect to when it's in range
PREFERRED_SSID="YourHomeWifi"
PREFERRED_PASSWORD="homepassword"

# The hotspot to fall back to when PREFERRED_SSID is not in range
HOTSPOT_SSID="PiHotspot"
HOTSPOT_PASSWORD="hotspotpassword"
