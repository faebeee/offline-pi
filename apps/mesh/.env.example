# Copy this file to .env and adjust as needed.
# ./install.sh creates .env from this file automatically on first run.

# Where the message history and node list are stored (mesh.db, SQLite; a few
# MB at most). Point this at your SSD mount on a Raspberry Pi if you like,
# e.g. /mnt/ssd/mesh/data; the SD card is fine too, writes are small. Re-run
# ./install.sh after changing this to move existing data there.
DATA_DIR=./data

# Port of the web UI.
# NB: other offline-pi apps use 8080 (monitor), 8081 (maps), 8082 (knowledge),
# 8083 (portal), 8085 (radio) and 8086 (mesh-map).
PORT=8084

# Address to listen on: 0.0.0.0 for LAN/hotspot access, 127.0.0.1 for local only.
BIND_ADDRESS=0.0.0.0

# How the app reaches the Meshtastic node:
#   serial - node plugged into the Pi by USB (default)
#   tcp    - node on the network (WiFi/Ethernet node or meshtasticd), see MESH_HOST
MESH_CONNECTION=serial

# Serial device of the USB node. install.sh lists /dev/serial/by-id/* and
# writes the chosen one here (stable across reboots, unlike /dev/ttyACM0).
# /dev/null when MESH_CONNECTION=tcp.
MESH_DEVICE=/dev/ttyACM0

# Hostname or IP of the node, only used when MESH_CONNECTION=tcp (port 4403).
MESH_HOST=

# Optional PIN required to send messages from the web UI. Empty: anyone who
# can open the web UI can send. Reading is never protected.
SEND_PIN=

# Max messages per client IP from the web UI, e.g. 5/min, 30/hour; 0 = off.
# Airtime on LoRa is shared and duty-cycle limited (10% in EU_868).
SEND_RATE_LIMIT=5/min

# Port of apps/mesh-map on the same host. The page on this port may read the
# node list (read-only) to draw every node on a map, and "Show on map" on the
# Nodes tab opens it. off disables both.
MESH_MAP_PORT=8086

# Port of apps/maps on the same host. "Show on map" falls back to it (centred
# on the node, no marker) when MESH_MAP_PORT is off. off hides the links then.
MAPS_PORT=8081
