# Copy this file to .env and adjust as needed.
# ./install.sh creates .env from this file automatically on first run.

# Port of the web UI.
# NB: other offline-pi apps use 8080 (monitor), 8081 (maps), 8082 (knowledge),
# 8083 (portal), 8084 (mesh) and 8085 (radio).
PORT=8086

# Address to listen on: 0.0.0.0 for LAN/hotspot access, 127.0.0.1 for local only.
BIND_ADDRESS=0.0.0.0

# Port of apps/mesh on this same host. The browser reads the node list from it;
# apps/mesh must allow this app's port (its MESH_MAP_PORT, default 8086).
# off shows the map without nodes.
MESH_PORT=8084

# apps/maps' data and assets directories (its DATA_DIR and ASSETS_DIR), mounted
# read-only: mesh-map reuses the regions downloaded there and stores nothing
# of its own. If apps/maps keeps them on an SSD, point these at the same
# place, e.g. /mnt/ssd/maps/data and /mnt/ssd/maps/assets. install.sh asks on
# every run and defaults to what apps/maps/.env says.
MAPS_DATA_DIR=../maps/data
MAPS_ASSETS_DIR=../maps/assets
