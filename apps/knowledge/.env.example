# Copy this file to .env and adjust as needed.
# Run `./install.sh` once to have this generated/validated for you interactively.
# Which ZIMs are downloaded is not configured here but in zims.txt.

# Where ZIM files, catalog cache, and the kiwix library are stored. Holds
# several GB (see zims.txt for sizes).
# Point this at your SSD mount on a Raspberry Pi, e.g. /mnt/ssd/kiwix
CONTENT_DIR=./data

# Host port for kiwix-serve (container listens on 8080).
# NB: other offline-pi apps use 8080 (monitor) and 8081 (maps), so this defaults elsewhere to
# avoid colliding when multiple apps run on the same host/Pi.
KIWIX_PORT=8082

# Address kiwix-serve binds to inside the container.
# Use "all" (default), or "ipv4" / "ipv6" to restrict the address family.
BIND_ADDRESS=all

# true: on every start the container downloads entries of zims.txt that are
# missing on disk (needs internet; without it, it just serves what's there).
# false: only download when you run ./manage.sh sync.
AUTO_SYNC=true
