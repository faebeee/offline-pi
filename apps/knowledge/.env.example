# Copy this file to .env and adjust as needed.
# Run `./install.sh` once to have this generated/validated for you interactively.

# Where ZIM files, catalog cache, and metadata are stored.
# Point this at your SSD mount on a Raspberry Pi, e.g. /mnt/ssd/kiwix
CONTENT_DIR=./data

# Port kiwix-serve listens on (host port, mapped 1:1 to container).
# NB: other offline-pi apps use 8080 (maps), so this defaults elsewhere to
# avoid colliding when multiple apps run on the same host/Pi.
KIWIX_PORT=8081

# Address kiwix-serve binds to inside the container.
# Use "all" for LAN access, "ipv4" / "ipv6" to restrict family, or a specific IP.
BIND_ADDRESS=all
