{
  "name": "@offline-pi/core",
  "version": "1.0.0",
  "private": true,
  "description": "offline-pi core: the one API (NestJS, a domain module per feature), module gateway and supervisor; serves the web app",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest build && node dist/main.js",
