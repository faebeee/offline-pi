# outpost configuration. ./install.sh creates .env from this file and is the
# only script that writes it; start.sh and manage.sh only read it.
#
# Every *_DIR can point at an SSD mount on a Raspberry Pi, e.g.
# /mnt/ssd/outpost/maps. Re-run ./install.sh after changing one: it is
# re-asked on every run and existing data is moved to the new location.

# ------------------------------------------------------------------- core --
# The one port the LAN sees: dashboard plus every module under its path.
# Host networking, so this is the port on the Pi itself.
PORT=8080

# 0.0.0.0 for LAN/hotspot access, 127.0.0.1 for this Pi only.
BIND_ADDRESS=0.0.0.0

# Address the modules listen on. Keep 127.0.0.1: modules are reached through
# core on PORT and must not be exposed on their own.
MODULES_BIND_ADDRESS=127.0.0.1

# Installed modules (comma separated). install.sh asks on every run;
# start.sh only builds and creates these. Which of them run is chosen on the
# dashboard. Available: maps, knowledge, mesh, mesh-map
MODULES=maps,knowledge,mesh-map

# Dashboard data: 24 h metric history, power events, modules.json (which
# modules are switched on). Small, the SD card is fine.
CORE_DATA_DIR=./data/core

# How often the Pi is sampled and pushed to open dashboards, in milliseconds.
SAMPLE_INTERVAL_MS=2000

# Least severe level core logs (verbose, debug, log, warn, error, fatal).
# The Logs screen shows core's lines from this level up; debug helps when
# something misbehaves.
CORE_LOG_LEVEL=log

# Optional PIN asked before starting/stopping a module from the dashboard.
# Empty = anyone who can open the dashboard can start and stop modules.
CONTROL_PIN=

# Detected by install.sh on every run; leave as is.
# Podman storage root (its db.sql lists the containers), Podman API socket
# (module start/stop) and firmware mailbox for vcgencmd (/dev/null if not a Pi).
PODMAN_GRAPH_ROOT=
PODMAN_SOCKET=
VCIO_DEVICE=/dev/null

# ------------------------------------------------------------------- maps --
# /maps/: offline vector maps. Internal port (loopback only).
MAPS_PORT=8081
# Region archives (can be many GB), POI database. Point at your SSD.
MAPS_DATA_DIR=./data/maps
# Vendored fonts and sprites (~100 MB).
MAPS_ASSETS_DIR=./data/maps-assets
# Extra origins allowed to call the maps API, e.g. http://maps.local:8080
MAPS_ALLOWED_ORIGINS=
# Empty = SQLite in MAPS_DATA_DIR; or a Postgres URL for the POIs.
MAPS_DATABASE_URL=
MAPS_DB_LOGGING=false

# -------------------------------------------------------------- knowledge --
# /library/: Kiwix library (Wikipedia, WikiMed, ...). Internal port.
KNOWLEDGE_PORT=8082
# ZIM files: the books chosen on the Library screen (from a few MB to
# hundreds of GB). Nothing is downloaded until you choose. Point at your SSD.
KNOWLEDGE_CONTENT_DIR=./data/knowledge
# true: resume downloads of selected books when the container starts (after a
# restart or power cut). false: only from the Library screen or
# ./manage.sh knowledge sync.
KNOWLEDGE_AUTO_SYNC=true

# ------------------------------------------------------------------- mesh --
# /mesh/: Meshtastic messaging through a USB LoRa node. Internal port.
MESH_PORT=8084
# Message history (SQLite, small).
MESH_DATA_DIR=./data/mesh
# serial (USB) or tcp; set by install.sh. Empty = not configured yet, the
# dashboard won't start mesh until ./install.sh has configured it.
MESH_CONNECTION=
# serial: stable /dev/serial/by-id/ path of the node (chosen by install.sh)
MESH_DEVICE=/dev/null
# tcp: hostname or IP of the node
MESH_HOST=
# PIN for sending from the web UI (empty = no PIN)
MESH_SEND_PIN=
MESH_SEND_RATE_LIMIT=5/min

# --------------------------------------------------------------- mesh-map --
# /mesh-map/: live map of the mesh nodes, on the maps module's regions
# (MAPS_DATA_DIR / MAPS_ASSETS_DIR, read-only). Internal port.
MESH_MAP_PORT=8086
