# outpost configuration. ./install.sh creates .env from this file and is the
# only script that writes it; start.sh and manage.sh only read it.
#
# Data: install.sh asks for one folder (OUTPOST_DATA_DIR, e.g. an SSD at
# /mnt/ssd/outpost) and puts every *_DIR in it under its default name.
# Re-run ./install.sh to move it: existing data is moved along.
# ./install.sh --advanced asks for each *_DIR on its own.

# ------------------------------------------------------------------ setup --
# The folder all data lives in (set by install.sh).
OUTPOST_DATA_DIR=./data

# Where the ready-made images come from: <registry>/outpost-<service>, one
# per commit (.github/workflows/images.yml). A fork publishing its own sets
# its ghcr.io/<owner> here.
OUTPOST_REGISTRY=ghcr.io/faebeee

# true: always build the images on this machine instead of downloading them
# (slow on a Pi). Also: ./install.sh --build, ./start.sh --build.
OUTPOST_BUILD=false

# ------------------------------------------------------------------- core --
# The one port the LAN sees: dashboard plus every module under its path.
# Host networking, so this is the port on the Pi itself.
PORT=8080

# 0.0.0.0 for LAN/hotspot access, 127.0.0.1 for this Pi only.
BIND_ADDRESS=0.0.0.0

# Address the modules listen on. Keep 127.0.0.1: modules are reached through
# core on PORT and must not be exposed on their own.
MODULES_BIND_ADDRESS=127.0.0.1

# Installed modules (comma separated). install.sh asks on every run;
# start.sh only gets the images of and creates these. Which of them run is
# chosen on the dashboard. Available: maps, knowledge, network.
# Files, Board and Supplies are built into core: always there.
MODULES=maps,knowledge

# Core's data: 24 h metric history, power events, modules.json (which
# modules are switched on), the Board's posts (board.json) and the Supplies
# list (supplies.json). Small.
CORE_DATA_DIR=./data/core

# How often the Pi is sampled and pushed to open dashboards, in milliseconds.
SAMPLE_INTERVAL_MS=2000

# Least severe level core logs (verbose, debug, log, warn, error, fatal).
# The Logs screen shows core's lines from this level up; debug helps when
# something misbehaves.
CORE_LOG_LEVEL=log

# Outgoing internet check for the status strip (NET · ONLINE / OFFLINE): a
# HEAD request to the first of these that answers, about once a minute. The
# defaults are servers outpost downloads from anyway. Empty = no check.
CORE_INTERNET_CHECK_URLS=https://build.protomaps.com/,https://download.kiwix.org/
CORE_INTERNET_CHECK_INTERVAL_MS=60000

# Optional PIN asked before starting/stopping a module from the dashboard.
# Empty = anyone who can open the dashboard can start and stop modules.
CONTROL_PIN=

# Detected by install.sh on every run; leave as is.
# Podman storage root (its db.sql lists the containers), Podman API socket
# (module start/stop) and firmware mailbox for vcgencmd (/dev/null if not a Pi).
PODMAN_GRAPH_ROOT=
PODMAN_SOCKET=
VCIO_DEVICE=/dev/null

# ------------------------------------------------------------------- maps --
# /maps/: offline vector maps. Internal port (loopback only).
MAPS_PORT=8081
# Region archives (can be many GB), POI database. Point at your SSD.
MAPS_DATA_DIR=./data/maps
# Vendored fonts and sprites (~100 MB).
MAPS_ASSETS_DIR=./data/maps-assets
# Extra origins allowed to call the maps API, e.g. http://maps.local:8080
MAPS_ALLOWED_ORIGINS=
# Empty = SQLite in MAPS_DATA_DIR; or a Postgres URL for the POIs.
MAPS_DATABASE_URL=
MAPS_DB_LOGGING=false

# -------------------------------------------------------------- knowledge --
# /library/: Kiwix library (Wikipedia, WikiMed, ...). Internal port.
KNOWLEDGE_PORT=8082
# ZIM files: the books chosen on the Library screen (from a few MB to
# hundreds of GB). Nothing is downloaded until you choose. Point at your SSD.
KNOWLEDGE_CONTENT_DIR=./data/knowledge
# true: resume downloads of selected books when the container starts (after a
# restart or power cut). false: only from the Library screen or
# ./manage.sh knowledge sync.
KNOWLEDGE_AUTO_SYNC=true

# ---------------------------------------------------------------- network --
# /network/: the devices on the Pi's Wi-Fi hotspot, with a block switch.
# Internal port.
NETWORK_PORT=8085
# Block list and the devices seen in the last 30 days (a few KB).
NETWORK_DATA_DIR=./data/network
# Hotspot interface, e.g. wlan0. Empty = the first Wi-Fi interface in
# access-point mode.
NETWORK_IFACE=
# Folder with the hotspot's DHCP leases (IP and hostname of each device),
# mounted read-only. NetworkManager (hotspot-pi) keeps them here; install.sh
# points it at NETWORK_DATA_DIR on hosts without NetworkManager.
NETWORK_LEASES_PATH=/var/lib/NetworkManager

# ------------------------------------------------------------------ files --
# /files/: the shared folder, served by core.
# The shared files (photos, documents, scans): grows with every upload.
FILES_DATA_DIR=./data/files
# Largest file one upload may be, in MB.
FILES_MAX_UPLOAD_MB=4096
# Uploads are refused when they would leave less than this free, in MB, so
# the disk never fills up completely.
FILES_MIN_FREE_MB=1024
